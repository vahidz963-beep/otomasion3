# Frontend (safe to expose through Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Netlify Functions only (never add the VITE_ prefix to the service-role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Professional backup center (server only; never use VITE_ prefixes)
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@host:5432/postgres
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret-and-keep-it-stable
BACKUP_LOCAL_MAX_VERSIONS=5
BACKUP_LOCAL_OVERDUE_HOURS=48
BACKUP_TRANSFER_TTL_MINUTES=60
APP_VERSION=139.0.1
# Optional storage safeguards
BACKUP_MAX_STORAGE_BYTES=268435456
BACKUP_MAX_SINGLE_FILE_BYTES=67108864
